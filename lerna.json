{
    "version": "independent",
    "command": {
        "publish": {
            "message": "chore(release): publish",
            "ignoreChanges": [
                "*.md",
                "**/.github/**",
                "**/__tests__/**",
                "**/test/**",
                "**/ci/**"
            ]
        },
        "version": {
            "allowBranch": "main",
            "conventionalCommits": true,
            "changelogPreset": {
                "name": "./changelog-preset.js",
                "types": [
                    {
                        "type": "feat",
                        "section": "Features"
                    },
                    {
                        "type": "fix",
                        "section": "Bug Fixes"
                    },
                    {
                        "type": "chore",
                        "scope": "deps",
                        "section": "Dependencies"
                    },
                    {
                        "type": "build",
                        "scope": "deps",
                        "section": "Dependencies"
                    }
                ]
            }
        }
    },
    "$schema": "node_modules/lerna/schemas/lerna-schema.json"
}
